<Window
    x:Class="RustService.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar"
                  Title="RustService"
                  Subtitle="Technician toolkit"
                  IsPaneToggleButtonVisible="True"
                  PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <FontIconSource Glyph="&#xE90F;" FontFamily="Segoe Fluent Icons"/>
            </TitleBar.IconSource>
        </TitleBar>
        <NavigationView x:Name="Nav"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        SelectionChanged="Nav_SelectionChanged"
                        Loaded="Nav_Loaded">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Service" Tag="service">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Repair"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Agent" Tag="agent">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Message"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="System Info" Tag="system-info">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="View"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Component Test" Tag="component-test">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="TouchPointer"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Shortcuts" Tag="shortcuts">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Go"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Programs" Tag="programs">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="AllApps"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Scripts" Tag="scripts">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Document"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator/>
                <NavigationViewItem Content="Network Diagnostics" Tag="network-diagnostics">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Globe"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Startup Manager" Tag="startup-manager">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Play"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Event Log" Tag="event-log">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Calendar"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Bluescreen" Tag="bluescreen">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Important"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Reports" Tag="reports">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Library"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <InfoBar x:Name="StatusBar"
                         IsOpen="False"
                         IsClosable="True"
                         Margin="12,8,12,0"/>
                <Frame x:Name="ContentFrame" Grid.Row="1" Background="Transparent">
                    <Frame.ContentTransitions>
                        <TransitionCollection>
                            <NavigationThemeTransition/>
                        </TransitionCollection>
                    </Frame.ContentTransitions>
                </Frame>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
