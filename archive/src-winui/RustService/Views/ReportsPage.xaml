<Page x:Class="RustService.Views.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
    <Grid Padding="16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <CommandBar DefaultLabelPosition="Right">
            <AppBarButton Icon="Refresh" Label="Refresh" Click="Refresh_Click"/>
            <AppBarButton Icon="Delete" Label="Delete" Click="Delete_Click"/>
            <AppBarButton Icon="Clear" Label="Clear all" Click="Clear_Click"/>
            <AppBarButton Icon="Document" Label="PDF" Click="Pdf_Click"/>
            <AppBarButton Icon="Add" Label="Add finding" Click="AddFinding_Click"/>
            <AppBarButton Icon="Remove" Label="Remove finding" Click="RemoveFinding_Click"/>
            <AppBarButton Icon="Sync" Label="Retrain times" Click="Retrain_Click"/>
            <AppBarButton Icon="Cancel" Label="Clear metrics" Click="ClearMetrics_Click"/>
        </CommandBar>
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListView x:Name="List" SelectionChanged="List_SelectionChanged" ItemTemplate="{StaticResource CardItemTemplate}"/>
            <Pivot Grid.Column="1">
                <PivotItem Header="Findings">
                    <ListView x:Name="FindingsList" ItemTemplate="{StaticResource CardItemTemplate}"/>
                </PivotItem>
                <PivotItem Header="Printout">
                    <TextBox x:Name="PrintoutBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas"/>
                </PivotItem>
                <PivotItem Header="Customer Print">
                    <TextBox x:Name="CustomerBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"/>
                </PivotItem>
            </Pivot>
        </Grid>
    </Grid>
</Page>
