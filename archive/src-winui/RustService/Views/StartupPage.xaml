<Page x:Class="RustService.Views.StartupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
    <Grid Padding="16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <CommandBar DefaultLabelPosition="Right">
            <AppBarButton Icon="Refresh" Label="Refresh" Click="Refresh_Click"/>
            <AppBarButton Icon="Play" Label="Toggle" Click="Toggle_Click"/>
            <AppBarButton Icon="Delete" Label="Delete" Click="Delete_Click"/>
            <AppBarButton Icon="OpenLocal" Label="Open location" Click="Open_Click"/>
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0">
                    <TextBox x:Name="SearchBox" Header="Search" Width="180" TextChanged="Search_Changed"/>
                    <ComboBox x:Name="SourceBox" Header="Source" Width="180" SelectionChanged="Source_Changed"/>
                </StackPanel>
            </CommandBar.Content>
        </CommandBar>
        <ListView x:Name="List" Grid.Row="1" ItemTemplate="{StaticResource CardItemTemplate}"/>
    </Grid>
</Page>
