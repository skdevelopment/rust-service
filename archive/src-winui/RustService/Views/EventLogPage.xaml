<Page x:Class="RustService.Views.EventLogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
    <Grid Padding="16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="140"/>
        </Grid.RowDefinitions>
        <CommandBar DefaultLabelPosition="Right">
            <AppBarButton Icon="Find" Label="Query" Click="Query_Click"/>
            <AppBarButton Icon="Copy" Label="Copy" Click="Copy_Click"/>
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0">
                    <ComboBox x:Name="LogBox" Header="Log" Width="160" SelectionChanged="Filter_Changed"/>
                    <ComboBox x:Name="LevelBox" Header="Level" Width="120" SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="All" IsSelected="True"/>
                        <ComboBoxItem Content="Critical"/>
                        <ComboBoxItem Content="Error"/>
                        <ComboBoxItem Content="Warning"/>
                        <ComboBoxItem Content="Information"/>
                    </ComboBox>
                    <TextBox x:Name="SourceBox" Header="Provider" Width="140"/>
                    <TextBox x:Name="KeywordBox" Header="Keyword" Width="140"/>
                    <ComboBox x:Name="LimitBox" Header="Limit" Width="80" SelectedIndex="1">
                        <ComboBoxItem Content="50"/>
                        <ComboBoxItem Content="100"/>
                        <ComboBoxItem Content="200"/>
                        <ComboBoxItem Content="500"/>
                    </ComboBox>
                </StackPanel>
            </CommandBar.Content>
        </CommandBar>
        <TextBlock x:Name="StatsText" Grid.Row="1" Opacity="0.8"/>
        <ListView x:Name="List" Grid.Row="2" SelectionChanged="List_SelectionChanged" ItemTemplate="{StaticResource CardItemTemplate}"/>
        <TextBox x:Name="DetailBox" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas"/>
    </Grid>
</Page>
