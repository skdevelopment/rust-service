<Page x:Class="RustService.Views.SystemInfoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Refresh" Click="Refresh_Click"/>
            <Button Content="Create restore point" Click="Restore_Click"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"/>
        </StackPanel>
        <GridView x:Name="Cards" Grid.Row="1" ItemTemplate="{StaticResource CardItemTemplate}"/>
    </Grid>
</Page>
