<Page x:Class="RustService.Views.ScriptsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
    <Grid Padding="16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>
        <CommandBar DefaultLabelPosition="Right">
            <AppBarButton Icon="Add" Label="New" Click="New_Click"/>
            <AppBarButton Icon="Save" Label="Save" Click="Save_Click"/>
            <AppBarButton Icon="Play" Label="Run" Click="Run_Click"/>
            <AppBarButton Icon="Delete" Label="Delete" Click="Delete_Click"/>
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0">
                    <TextBox x:Name="SearchBox" Header="Search" Width="140" TextChanged="Search_Changed"/>
                    <ComboBox x:Name="SortBox" Header="Sort" Width="140" SelectionChanged="Sort_Changed">
                        <ComboBoxItem Content="Name" Tag="name" IsSelected="True"/>
                        <ComboBoxItem Content="Name Z-A" Tag="name-desc"/>
                        <ComboBoxItem Content="Most run" Tag="used"/>
                        <ComboBoxItem Content="Added" Tag="added"/>
                        <ComboBoxItem Content="Last run" Tag="run"/>
                    </ComboBox>
                    <TextBox x:Name="NameBox" Header="Name" Width="140"/>
                    <TextBox x:Name="DescBox" Header="Description" Width="160"/>
                    <ComboBox x:Name="TypeBox" Header="Type" Width="120" SelectedIndex="0">
                        <ComboBoxItem Content="powershell"/>
                        <ComboBoxItem Content="cmd"/>
                    </ComboBox>
                    <CheckBox x:Name="AdminBox" Content="Admin" VerticalAlignment="Bottom"/>
                </StackPanel>
            </CommandBar.Content>
        </CommandBar>
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListView x:Name="List" SelectionChanged="List_SelectionChanged" ItemTemplate="{StaticResource CardItemTemplate}"/>
            <TextBox x:Name="ContentBox" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas"/>
        </Grid>
        <TextBox x:Name="OutputBox" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True"/>
    </Grid>
</Page>
