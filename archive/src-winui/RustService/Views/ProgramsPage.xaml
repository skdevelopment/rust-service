<Page x:Class="RustService.Views.ProgramsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
    <Grid Padding="16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <CommandBar DefaultLabelPosition="Right">
            <AppBarButton Icon="Play" Label="Launch" Click="Launch_Click"/>
            <AppBarButton Icon="OpenLocal" Label="Reveal" Click="Reveal_Click"/>
            <AppBarButton Icon="Save" Label="Save edit" Click="Save_Click"/>
            <AppBarButton Icon="Delete" Label="Delete" Click="Delete_Click"/>
            <AppBarButton Icon="Download" Label="Import folder" Click="Import_Click"/>
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0">
                    <TextBox x:Name="SearchBox" Header="Search" Width="180" TextChanged="Search_Changed"/>
                    <ComboBox x:Name="SortBox" Header="Sort" Width="180" SelectionChanged="Sort_Changed">
                        <ComboBoxItem Content="Name A-Z" Tag="name-asc" IsSelected="True"/>
                        <ComboBoxItem Content="Name Z-A" Tag="name-desc"/>
                        <ComboBoxItem Content="Most used" Tag="most-used"/>
                        <ComboBoxItem Content="Recently added" Tag="recently-added"/>
                        <ComboBoxItem Content="Recently launched" Tag="recently-launched"/>
                    </ComboBox>
                </StackPanel>
            </CommandBar.Content>
        </CommandBar>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="NameBox" Header="Name" Width="160"/>
            <TextBox x:Name="DescBox" Header="Description" Width="200"/>
            <TextBox x:Name="PathBox" Header="Exe path" Width="280"/>
            <Button Content="Browse" Click="Browse_Click"/>
            <CheckBox x:Name="CliBox" Content="CLI" VerticalAlignment="Bottom"/>
            <Button Content="Add" Click="Add_Click" Style="{StaticResource AccentButtonStyle}"/>
        </StackPanel>
        <GridView x:Name="List" Grid.Row="2" SelectionChanged="List_SelectionChanged" DoubleTapped="List_DoubleTapped">
            <GridView.ItemTemplate>
                <DataTemplate>
                    <Border Width="280" MinHeight="88" Padding="12" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Width="32" Height="32" Source="{Binding Icon}" Stretch="Uniform"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Meta}" Opacity="0.75" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
