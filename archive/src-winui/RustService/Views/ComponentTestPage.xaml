<Page x:Class="RustService.Views.ComponentTestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
    <Pivot>
        <PivotItem Header="Camera">
            <Grid Padding="16" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="CameraBox" Header="Camera" Width="280"/>
                    <Button Content="Start preview" Click="CameraStart_Click"/>
                    <Button Content="Stop" Click="CameraStop_Click"/>
                    <Button Content="Screenshot" Click="CameraShot_Click"/>
                    <ToggleSwitch x:Name="MirrorSwitch" Header="Mirror" Toggled="Mirror_Toggled"/>
                </StackPanel>
                <Border Grid.Row="1" Background="Black" CornerRadius="8">
                    <MediaPlayerElement x:Name="CameraPreview" AreTransportControlsEnabled="False" Stretch="Uniform"/>
                </Border>
                <TextBlock x:Name="CameraStatus" Grid.Row="2" TextWrapping="Wrap"/>
            </Grid>
        </PivotItem>
        <PivotItem Header="Audio">
            <StackPanel Padding="16" Spacing="8">
                <Button Content="Play 440 Hz tone" Click="Tone_Click"/>
                <Button Content="Start microphone" Click="MicStart_Click"/>
                <Button Content="Stop microphone" Click="MicStop_Click"/>
                <ProgressBar x:Name="MicLevel" Maximum="100"/>
                <TextBlock x:Name="AudioStatus" TextWrapping="Wrap"/>
            </StackPanel>
        </PivotItem>
        <PivotItem Header="Keyboard">
            <Grid Padding="16" RowSpacing="8" KeyDown="Page_KeyDown" KeyUp="Page_KeyUp" IsTabStop="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="LayoutBox" Header="Layout" Width="200" SelectionChanged="Layout_Changed">
                        <ComboBoxItem Content="full" IsSelected="True"/>
                        <ComboBoxItem Content="tkl"/>
                        <ComboBoxItem Content="compact"/>
                    </ComboBox>
                    <Button Content="Reset" Click="KeyboardReset_Click"/>
                    <TextBlock x:Name="KeyStatus" VerticalAlignment="Bottom"/>
                </StackPanel>
                <ProgressBar x:Name="KeyProgress" Grid.Row="1" Maximum="100"/>
                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto">
                    <StackPanel x:Name="KeyRows" Spacing="4"/>
                </ScrollViewer>
            </Grid>
        </PivotItem>
        <PivotItem Header="Mouse">
            <Grid Padding="16" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="Reset" Click="MouseReset_Click"/>
                    <TextBlock x:Name="MouseStatus" VerticalAlignment="Center"/>
                </StackPanel>
                <Border x:Name="MouseCanvas" Grid.Row="1" BorderThickness="2" CornerRadius="8" Padding="8"
                        PointerMoved="Canvas_PointerMoved" PointerPressed="Canvas_PointerPressed"
                        PointerReleased="Canvas_PointerReleased" PointerWheelChanged="Canvas_Wheel"
                        DoubleTapped="Canvas_DoubleTapped" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid>
                        <TextBlock Text="Click, scroll, and drag here" Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock x:Name="MousePos" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    </Grid>
                </Border>
            </Grid>
        </PivotItem>
        <PivotItem Header="Gamepad">
            <StackPanel Padding="16" Spacing="8">
                <TextBlock Text="Connect a controller. Readings update live (A/B/X/Y, sticks, triggers)." TextWrapping="Wrap"/>
                <TextBlock x:Name="GamepadStatus" TextWrapping="Wrap" FontFamily="Consolas"/>
            </StackPanel>
        </PivotItem>
        <PivotItem Header="Touch">
            <Grid Padding="16" PointerPressed="Touch_PointerPressed" Background="Transparent">
                <TextBlock x:Name="TouchStatus" Text="Tap this pane with a touch screen." TextWrapping="Wrap"/>
            </Grid>
        </PivotItem>
        <PivotItem Header="Network">
            <StackPanel Padding="16" Spacing="8">
                <Button Content="Ping Google / Cloudflare / Microsoft" Click="Network_Click"/>
                <TextBlock x:Name="NetStatus" TextWrapping="Wrap"/>
            </StackPanel>
        </PivotItem>
        <PivotItem Header="Display">
            <Grid Padding="16" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="PatternBox" Header="Pattern" Width="180" SelectionChanged="Pattern_Changed">
                        <ComboBoxItem Content="red" IsSelected="True"/>
                        <ComboBoxItem Content="green"/>
                        <ComboBoxItem Content="blue"/>
                        <ComboBoxItem Content="white"/>
                        <ComboBoxItem Content="black"/>
                        <ComboBoxItem Content="gradient"/>
                        <ComboBoxItem Content="checkerboard"/>
                        <ComboBoxItem Content="grid"/>
                        <ComboBoxItem Content="smpte"/>
                        <ComboBoxItem Content="stripes-h"/>
                        <ComboBoxItem Content="stripes-v"/>
                    </ComboBox>
                    <Button Content="Apply" Click="Display_Click"/>
                </StackPanel>
                <Border x:Name="DisplayFill" Grid.Row="1"/>
            </Grid>
        </PivotItem>
        <PivotItem Header="More">
            <StackPanel Padding="16" Spacing="8">
                <Button Content="Scan Bluetooth / USB / battery" Click="More_Click"/>
                <TextBlock x:Name="MoreStatus" TextWrapping="Wrap"/>
            </StackPanel>
        </PivotItem>
    </Pivot>
</Page>
