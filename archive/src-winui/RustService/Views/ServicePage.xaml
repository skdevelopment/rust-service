<Page x:Class="RustService.Views.ServicePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
    <Pivot x:Name="Steps">
        <PivotItem Header="Presets">
            <Grid Padding="16" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Choose a service preset, then continue to the queue." Style="{StaticResource BodyTextBlockStyle}"/>
                <GridView x:Name="PresetList" Grid.Row="1" SelectionMode="Single" SelectionChanged="PresetList_SelectionChanged"
                          ItemTemplate="{StaticResource CardItemTemplate}"/>
                <CommandBar Grid.Row="2" DefaultLabelPosition="Right">
                    <AppBarButton Icon="Add" Label="Save as preset" Click="SavePreset_Click"/>
                    <AppBarButton Icon="Delete" Label="Delete custom" Click="DeletePreset_Click"/>
                    <AppBarSeparator/>
                    <AppBarButton Icon="Forward" Label="Continue to Queue" Click="GoQueue_Click"/>
                    <CommandBar.Content>
                        <TextBox x:Name="CustomPresetName" Header="Custom preset name" Width="220" Margin="8,0"/>
                    </CommandBar.Content>
                </CommandBar>
            </Grid>
        </PivotItem>
        <PivotItem Header="Queue">
            <Grid Padding="16" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <CommandBar DefaultLabelPosition="Right">
                    <AppBarToggleButton x:Name="ParallelSwitch" Label="Parallel" Icon="Shuffle"/>
                    <AppBarButton Icon="Accept" Label="Toggle enabled" Click="ToggleEnabled_Click"/>
                    <AppBarButton Icon="Setting" Label="Configure" Click="Configure_Click"/>
                    <AppBarButton Icon="Up" Label="Move up" Click="MoveUp_Click"/>
                    <AppBarButton Icon="Download" Label="Move down" Click="MoveDown_Click"/>
                    <AppBarButton Icon="Add" Label="Add service" Click="AddService_Click"/>
                    <AppBarButton Icon="Play" Label="Start run" Click="Start_Click"/>
                    <CommandBar.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0">
                            <TextBox x:Name="TechBox" Header="Technician" Width="160"/>
                            <TextBox x:Name="CustomerBox" Header="Customer" Width="160"/>
                        </StackPanel>
                    </CommandBar.Content>
                </CommandBar>
                <ListView x:Name="QueueList" Grid.Row="1" ItemTemplate="{StaticResource CardItemTemplate}"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="Back to Presets" Click="GoPresets_Click"/>
                    <Button Content="Start run" Click="Start_Click" Style="{StaticResource AccentButtonStyle}"/>
                </StackPanel>
            </Grid>
        </PivotItem>
        <PivotItem Header="Runner">
            <Grid Padding="16" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="StatusText" Style="{StaticResource SubtitleTextBlockStyle}" Text="Idle"/>
                <ProgressBar x:Name="RunProgress" Grid.Row="1"/>
                <TextBox x:Name="LogBox" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas"/>
                <CommandBar Grid.Row="3" DefaultLabelPosition="Right">
                    <AppBarButton Icon="Pause" Label="Pause" Click="Pause_Click"/>
                    <AppBarButton Icon="Play" Label="Resume" Click="Resume_Click"/>
                    <AppBarButton Icon="Cancel" Label="Cancel" Click="Cancel_Click"/>
                    <AppBarButton Icon="Forward" Label="View results" Click="GoResults_Click"/>
                </CommandBar>
            </Grid>
        </PivotItem>
        <PivotItem Header="Results">
            <Grid Padding="16" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <CommandBar DefaultLabelPosition="Right">
                    <AppBarButton Icon="Refresh" Label="Refresh stats" Click="RefreshResults_Click"/>
                    <AppBarButton Icon="Document" Label="Generate PDF" Click="Pdf_Click"/>
                    <AppBarButton Icon="Save" Label="Save summary" Click="SaveSummary_Click"/>
                    <CommandBar.Content>
                        <TextBox x:Name="SummaryBox" Header="Agent summary" Width="280" Margin="8,0"/>
                    </CommandBar.Content>
                </CommandBar>
                <Pivot Grid.Row="1">
                    <PivotItem Header="Findings">
                        <ListView x:Name="FindingsList" ItemTemplate="{StaticResource CardItemTemplate}"/>
                    </PivotItem>
                    <PivotItem Header="Printout">
                        <TextBox x:Name="PrintoutBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas"/>
                    </PivotItem>
                    <PivotItem Header="Customer Print">
                        <TextBox x:Name="CustomerPrintBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"/>
                    </PivotItem>
                </Pivot>
            </Grid>
        </PivotItem>
    </Pivot>
</Page>
