<Page x:Class="RustService.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
    <ScrollViewer Padding="16">
        <StackPanel Spacing="12" MaxWidth="760">
            <Expander Header="Appearance" IsExpanded="True">
                <StackPanel Spacing="8" Margin="0,8,0,0">
                    <ComboBox x:Name="ThemeBox" Header="Theme" Width="280">
                        <ComboBoxItem Content="system"/>
                        <ComboBoxItem Content="light"/>
                        <ComboBoxItem Content="dark"/>
                    </ComboBox>
                    <ComboBox x:Name="SchemeBox" Header="Color scheme" Width="280"/>
                    <ToggleSwitch x:Name="AnimSwitch" Header="Animations"/>
                </StackPanel>
            </Expander>
            <Expander Header="Business" IsExpanded="True">
                <StackPanel Spacing="8" Margin="0,8,0,0">
                    <TextBox x:Name="BizName" Header="Business name"/>
                    <TextBox x:Name="BizPhone" Header="Phone"/>
                    <TextBox x:Name="BizEmail" Header="Email"/>
                    <TextBox x:Name="BizAddress" Header="Address"/>
                    <TextBox x:Name="BizWebsite" Header="Website"/>
                    <TextBox x:Name="BizAbn" Header="ABN"/>
                    <TextBox x:Name="LogoPathBox" Header="Logo path"/>
                    <Button Content="Save logo from path" Click="SaveLogo_Click"/>
                </StackPanel>
            </Expander>
            <Expander Header="Required programs" IsExpanded="True">
                <StackPanel Spacing="8" Margin="0,8,0,0">
                    <ListView x:Name="RequiredList" Height="200" ItemTemplate="{StaticResource CardItemTemplate}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="OverrideId" Header="Program id" Width="160"/>
                        <TextBox x:Name="OverridePath" Header="Custom exe path" Width="280"/>
                        <Button Content="Set override" Click="Override_Click"/>
                        <Button Content="Clear override" Click="ClearOverride_Click"/>
                    </StackPanel>
                </StackPanel>
            </Expander>
            <Expander Header="AI Agent / MCP" IsExpanded="True">
                <StackPanel Spacing="8" Margin="0,8,0,0">
                    <ComboBox x:Name="ProviderBox" Header="Provider" Width="280"/>
                    <TextBox x:Name="ModelBox" Header="Model"/>
                    <TextBox x:Name="BaseUrlBox" Header="Base URL (Ollama / custom)"/>
                    <PasswordBox x:Name="ApiKeyBox" Header="API key"/>
                    <TextBox x:Name="PromptBox" Header="System prompt" AcceptsReturn="True" Height="80" TextWrapping="Wrap"/>
                    <ComboBox x:Name="SearchProviderBox" Header="Search provider" Width="280">
                        <ComboBoxItem Content="none"/>
                        <ComboBoxItem Content="tavily"/>
                        <ComboBoxItem Content="searxng"/>
                    </ComboBox>
                    <PasswordBox x:Name="TavilyBox" Header="Tavily API key"/>
                    <TextBox x:Name="SearxBox" Header="SearXNG URL"/>
                    <ComboBox x:Name="ApprovalBox" Header="Approval mode" Width="280">
                        <ComboBoxItem Content="always"/>
                        <ComboBoxItem Content="whitelist"/>
                        <ComboBoxItem Content="yolo"/>
                    </ComboBox>
                    <TextBox x:Name="WhitelistBox" Header="Whitelist regex (one per line)" AcceptsReturn="True" Height="100" TextWrapping="Wrap" FontFamily="Consolas"/>
                    <ToggleSwitch x:Name="McpSwitch" Header="MCP server"/>
                    <NumberBox x:Name="McpPort" Header="MCP port" Minimum="1" Maximum="65535"/>
                    <TextBox x:Name="McpKey" Header="MCP API key"/>
                </StackPanel>
            </Expander>
            <Expander Header="Technician tabs">
                <StackPanel Spacing="8" Margin="0,8,0,0">
                    <TextBox x:Name="TabsBox" Header="One per line: name|https://url" AcceptsReturn="True" Height="100" TextWrapping="Wrap"/>
                    <ComboBox x:Name="LogBox" Header="Log level" Width="160">
                        <ComboBoxItem Content="error"/>
                        <ComboBoxItem Content="warn"/>
                        <ComboBoxItem Content="info"/>
                        <ComboBoxItem Content="debug"/>
                    </ComboBox>
                </StackPanel>
            </Expander>
            <Button Content="Save settings" Click="Save_Click" Style="{StaticResource AccentButtonStyle}"/>
            <Button Content="Open data folder" Click="OpenData_Click"/>
        </StackPanel>
    </ScrollViewer>
</Page>
