{
  // Oxlint, not ESLint: typescript-eslint needs the TypeScript JS API, which
  // TypeScript 7 no longer ships. Correctness rules (ESLint/TS recommended
  // equivalents) plus the React hooks rules — missing effect dependencies have
  // caused real bugs here, e.g. stale Event Log filters.
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "react", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    // React Compiler checks; the app does not use the compiler (yet).
    "react/set-state-in-effect": "off",
    "react/purity": "off",
    "react/static-components": "off",
    "react/immutability": "off",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }]
  },
  "ignorePatterns": ["dist", "node_modules", "src-tauri", "archive", "src/bindings.ts", "src/components/ui"]
}
